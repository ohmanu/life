---
import "../styles/console.css";

const tabs = [
  { id: "hoy", key: "F1", label: "Hoy" },
  { id: "encargos", key: "F2", label: "Encargos" },
  { id: "dinero", key: "F3", label: "Dinero" },
  { id: "redes", key: "F4", label: "Redes y código" },
  { id: "conexiones", key: "F5", label: "Conexiones" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LIFE</title>
  </head>
  <body>
    <div class="app" id="app">
      <header>
        <div class="titlebar">
          <div class="drag" data-tauri-drag-region>
            <span data-tauri-drag-region>LIFE — <span class="jp" data-tauri-drag-region>生活記録</span></span>
          </div>
          <div class="win">
            <button type="button" id="w-min" aria-label="Minimizar">–</button>
            <button type="button" id="w-max" aria-label="Maximizar">□</button>
            <button type="button" id="w-close" class="close" aria-label="Esconder en la bandeja">×</button>
          </div>
        </div>
        <div id="demo" class="demo-banner" hidden>MODO DEMO · DATOS DE EJEMPLO · ABRE LIFE COMO APP PARA VER LOS TUYOS</div>
      </header>

      <div class="statusbar" data-tauri-drag-region>
        <span class="logo"><span class="mark">生</span>LIFE<span class="slash">/</span><span class="cur" aria-hidden="true"></span></span>
        <span class="clock"><span class="signal" aria-hidden="true"><b></b><b></b><b></b><b></b></span><span id="clock">—</span></span>
        <span class="sources">
          <span class="src" id="src-github"><i></i>GitHub</span>
          <span class="src" id="src-gmail"><i></i>Gmail</span>
          <span class="src" id="src-revolut"><i></i>Revolut</span>
          <span class="src" id="src-instagram"><i></i>Instagram</span>
          <span class="src" id="src-claude"><i></i>Claude</span>
          <span class="src" id="src-youtube" data-youtube><i></i>YouTube</span>
        </span>
        <button class="btn" id="privacy" type="button" aria-pressed="false" title="Tecla P">Ocultar cifras</button>
      </div>

      <nav class="tabs" role="tablist" aria-label="Vistas">
        {tabs.map((t, i) => (
          <button role="tab" id={`tab-${t.id}`} aria-controls={`v-${t.id}`} aria-selected={i === 0 ? "true" : "false"} data-key={t.key}>
            <span class="fkey">{t.key}</span>{t.label}
          </button>
        ))}
      </nav>

      <main class="main">
        <!-- HOY -->
        <section class="view" id="v-hoy" role="tabpanel" aria-labelledby="tab-hoy">
          <div class="grid">
            <div class="cell c-7">
              <div class="cell-h"><h3 id="parte-h">Parte del día</h3>
                <span class="parte-tabs" id="parte-tabs" hidden role="group" aria-label="Parte">
                  <button type="button" class="btn" data-parte="diario" aria-pressed="true">Día</button><button type="button" class="btn" data-parte="semanal" aria-pressed="false">Semana</button>
                </span><span class="jp">本日の報告</span></div>
              <div class="frame" data-ch="CH 140.85"><ul class="brief" id="brief"></ul></div>
              <div class="foot"><span id="parte-origen">GENERADO EN LOCAL</span><span><span id="brief-time"></span> <button class="btn" type="button" id="parte-regen" hidden>Regenerar</button></span></div>
            </div>
            <div class="cell c-5">
              <div class="cell-h"><h3>Radar de vida</h3><span class="jp">生活レーダー</span></div>
              <div class="radar" id="radar-vista"><svg id="radar" viewBox="0 0 300 300" role="img" aria-label="Radar de vida"></svg></div>
              <div class="radar-nota" id="radar-nota"></div>
              <svg class="heat-svg" id="radar-hist" viewBox="0 0 300 44" role="img" aria-label="Forma del radar en las últimas semanas"></svg>
              <div class="foot"><span id="radar-foot">SIN SEÑAL</span><button class="btn" type="button" id="radar-recalc" hidden>Recalcular</button></div>
            </div>
            <div class="cell c-12" id="ask-cell">
              <div class="cell-h"><h3>Pregunta a LIFE</h3><span class="jp">質問</span></div>
              <form class="field ask" id="ask-form" autocomplete="off">
                <input id="ask-q" type="text" maxlength="400" placeholder="¿Cuánto gasté en restaurantes este año? ¿Qué publicación de Instagram fue mejor este mes?" aria-label="Pregunta a LIFE" spellcheck="true" />
                <button class="btn solid" type="submit" id="ask-go">Preguntar</button>
              </form>
              <div class="frame ask-out" id="ask-out" data-ch="RX" hidden><div id="ask-a"></div></div>
              <div class="foot"><span id="ask-foot">CLAUDE RESPONDE CON TUS DATOS DE LIFE · NO GUARDA LA PREGUNTA</span></div>
            </div>
            <div class="cell c-12">
              <div class="kpis five">
                <div class="kpi"><div class="k">Encargos sin responder</div><div class="v" data-e="sin">—</div><div class="d" data-e="sin_d"></div></div>
                <div class="kpi"><div class="k">Patrimonio</div><div class="v money" data-m="saldo">—</div><div class="d money" data-m="saldo_d"></div></div>
                <div class="kpi"><div class="k" data-m="gas_k">Gastos</div><div class="v money" data-m="gas">—</div><div class="d money" data-m="gas_d"></div></div>
                <div class="kpi"><div class="k">Seguidores Instagram</div><div class="v" data-i="seg">—</div><div class="d" data-i="seg_d"></div></div>
                <div class="kpi"><div class="k">Racha GitHub</div><div class="v" data-k="streak">—</div><div class="d" data-k="longest"></div></div>
              </div>
            </div>
            <div class="cell c-12">
              <div class="cell-h"><h3>Gastos · 52 semanas</h3><span class="jp">支出</span></div>
              <div class="heat-wrap"><svg class="heat-svg" id="heat-gas" viewBox="0 0 776 120" style="min-width:640px" role="img" aria-label="Mapa de gastos por día del último año"></svg></div>
              <div class="foot"><span id="heat-gas-foot"></span><span>COLOR SEGÚN LO GASTADO · PASA EL RATÓN POR UN DÍA</span></div>
            </div>
            <div class="cell c-12">
              <div class="cell-h"><h3>Publicaciones · 52 semanas</h3><span class="jp">投稿</span></div>
              <div class="heat-wrap"><svg class="heat-svg" id="heat-ig" viewBox="0 0 776 120" style="min-width:640px" role="img" aria-label="Mapa de publicaciones e historias de Instagram del último año"></svg></div>
              <div class="foot"><span id="heat-ig-foot"></span><span>HISTORIAS DESDE QUE LIFE LAS VA GUARDANDO</span></div>
            </div>
            <div class="cell c-12">
              <div class="cell-h"><h3>Contribuciones · 52 semanas</h3><span class="jp">貢献</span></div>
              <div class="heat-wrap"><svg class="heat-svg" id="heat" viewBox="0 0 776 120" style="min-width:640px" role="img" aria-label="Mapa de contribuciones de GitHub del último año"></svg></div>
              <div class="foot"><span id="heat-sync">SIN SINCRONIZAR</span><span>CADA HORA</span></div>
            </div>
          </div>
        </section>

        <!-- ENCARGOS -->
        <section class="view" id="v-encargos" role="tabpanel" aria-labelledby="tab-encargos" hidden>
          <div class="grid">
            <div class="cell c-12">
              <div class="kpis five">
                <div class="kpi"><div class="k">Sin responder</div><div class="v" data-e="sin">—</div><div class="d" data-e="sin_d"></div></div>
                <div class="kpi"><div class="k">Abiertos</div><div class="v" data-e="abiertos">—</div><div class="d" data-e="abiertos_d"></div></div>
                <div class="kpi"><div class="k">Este mes</div><div class="v" data-e="mes">—</div><div class="d" data-e="mes_d"></div></div>
                <div class="kpi"><div class="k">Respuesta media</div><div class="v" data-e="resp">—</div><div class="d">últimos 90 días</div></div>
                <div class="kpi"><div class="k">Cobrados</div><div class="v" data-e="cobrados">—</div><div class="d" data-e="cobrados_d"></div></div>
              </div>
            </div>
            <div class="cell c-12">
              <div class="cell-h"><h3>Tablero de encargos</h3><span class="jp">依頼ボード</span></div>
              <div class="board" id="board"></div>
              <div class="foot"><span id="enc-sync">SIN SINCRONIZAR</span><span><span id="enc-foot">GMAIL · SOLO LECTURA · CADA 10 MIN</span> <button class="btn" type="button" id="enc-desc" aria-pressed="false" hidden>Ver descartados</button></span></div>
            </div>
            <div class="cell c-7">
              <div class="cell-h"><h3>Hoja de encargo</h3><span class="jp">依頼票</span></div>
              <div id="ficha" class="ficha"></div>
            </div>
            <div class="cell c-5">
              <div class="cell-h"><h3>Encargos por mes</h3><span class="jp">月別</span></div>
              <svg class="heat-svg" id="enc-chart" viewBox="0 0 360 170" role="img" aria-label="Encargos recibidos por mes en el último año"></svg>
              <div class="foot"><span>12 MESES</span><span id="enc-chart-tot"></span></div>
            </div>
          </div>
        </section>

        <!-- DINERO -->
        <section class="view" id="v-dinero" role="tabpanel" aria-labelledby="tab-dinero" hidden>
          <div class="grid">
            <div class="cell c-12">
              <div class="strip">
                <div class="monthnav" role="group" aria-label="Mes">
                  <button type="button" class="btn" id="m-prev" aria-label="Mes anterior">◂</button>
                  <span id="m-label">—</span>
                  <button type="button" class="btn" id="m-next" aria-label="Mes siguiente">▸</button>
                </div>
                <span class="muted" id="rv-info">SIN DATOS · CONECTA REVOLUT EN F5</span>
              </div>
              <div class="msg" data-rv-msg role="status"></div>
            </div>
            <div class="cell c-12">
              <div class="kpis">
                <div class="kpi"><div class="k" data-m="ing_k">Ingresos</div><div class="v money" data-m="ing">—</div><div class="d money" data-m="ing_d"></div></div>
                <div class="kpi"><div class="k" data-m="gas_k">Gastos</div><div class="v money" data-m="gas">—</div><div class="d money" data-m="gas_d"></div></div>
                <div class="kpi"><div class="k">Tasa de ahorro</div><div class="v" data-m="tasa">—</div><div class="d" data-m="tasa_d"></div></div>
                <div class="kpi"><div class="k">Colchón</div><div class="v" data-m="colchon">—</div><div class="d">cuenta + hucha · gasto medio de 6 meses</div></div>
              </div>
            </div>
            <div class="cell c-12">
              <div class="cell-h"><h3>Patrimonio</h3><span class="jp">資産</span></div>
              <div class="patri" id="patri"></div>
              <form class="field patri-form" id="patri-form" autocomplete="off" hidden>
                <label class="lbl">Saldo de la hucha hoy (€)<input id="pf-hucha" type="number" step="0.01" min="0" inputmode="decimal" /></label>
                <label class="lbl">Onzas de oro (XAU), las que muestra Revolut<input id="pf-oro" type="number" step="0.000001" min="0" inputmode="decimal" /></label>
                <label class="lbl">TIN de la hucha (%)<input id="pf-tin" type="number" step="0.01" min="0" max="20" inputmode="decimal" /></label>
                <button class="btn solid" type="submit" id="pf-save">Guardar</button>
                <button class="btn" type="button" id="pf-cancel">Cancelar</button>
              </form>
              <div class="msg" id="patri-msg" role="status"></div>
              <div class="foot"><span id="patri-foot"></span><button class="btn" type="button" id="patri-edit">Ajustar a mano</button></div>
            </div>
            <div class="cell c-7">
              <div class="cell-h"><h3>Ingresos y gastos · 12 meses</h3><span class="jp">収支</span></div>
              <svg class="heat-svg" id="flow" viewBox="0 0 560 230" role="img" aria-label="Ingresos y gastos de los últimos 12 meses"></svg>
              <div class="legend"><span><i class="lg-nom"></i>Nómina</span><span><i class="lg-in"></i>Otros ingresos</span><span><i class="lg-out"></i>Gastos</span><span><i class="lg-acc"></i>Patrimonio: cuenta + hucha + oro</span><span class="muted">pulsa un mes para verlo</span></div>
            </div>
            <div class="cell c-5">
              <div class="cell-h"><h3 data-m="cats_h">Gasto por categoría</h3><span class="jp">分類</span></div>
              <div class="cats" id="cats"></div>
              <div class="foot"><span>↑ = POR ENCIMA DE SU MEDIA DE 6 MESES</span><button class="btn" type="button" id="revisar" hidden></button></div>
            </div>
            <div class="cell c-7">
              <div class="cell-h"><h3 id="movs-h">Movimientos</h3><span class="jp">取引</span></div>
              <div class="movs" id="movs"></div>
              <div class="foot"><span>LA CATEGORÍA QUE ELIGES SE RECUERDA PARA TODO EL COMERCIO · <span id="movs-n"></span></span><button class="btn" type="button" id="movs-edit" aria-pressed="false">Editar categorías</button></div>
            </div>
            <div class="cell c-5">
              <div class="cell-h"><h3 id="subs-mes-h">Suscripciones pagadas</h3><span class="jp">支払済</span></div>
              <table class="subs" id="subs-mes"></table>
              <div class="cell-h sub-h"><h3>Suscripciones y recurrentes</h3><span class="jp">定期購読</span></div>
              <table class="subs" id="subs"></table>
              <div class="cell-h sub-h"><h3>Próximos cobros · 30 días</h3><span class="jp">予定</span></div>
              <div class="rows" id="proximos"></div>
            </div>
          </div>
        </section>

        <!-- REDES Y CÓDIGO -->
        <section class="view" id="v-redes" role="tabpanel" aria-labelledby="tab-redes" hidden>
          <div class="grid">
            <div class="cell c-4 wide">
              <div class="cell-h"><h3>GitHub</h3><span class="jp">コード</span></div>
              <div class="kpi"><div class="v" data-k="streak">—</div><div class="sub" data-k="login"></div></div>
              <div class="rows" id="repos" style="margin-top:12px"></div>
            </div>
            <div class="cell c-8">
              <div class="cell-h"><h3 id="ig-h">Instagram</h3><span class="jp">写真</span></div>
              <div class="kpis">
                <div class="kpi"><div class="k">Seguidores</div><div class="v" data-i="seg">—</div><div class="d" data-i="seg_d"></div></div>
                <div class="kpi"><div class="k">Alcance · 30 d</div><div class="v" data-i="reach">—</div><div class="d" data-i="reach_d"></div></div>
                <div class="kpi"><div class="k">Visualizaciones · 30 d</div><div class="v" data-i="views">—</div><div class="d" data-i="views_d"></div></div>
                <div class="kpi"><div class="k">Interacciones · 30 d</div><div class="v" data-i="inter">—</div><div class="d" data-i="inter_d"></div></div>
              </div>
              <svg class="heat-svg" id="ig-chart" viewBox="0 0 560 150" role="img" aria-label="Alcance diario de Instagram en los últimos 30 días y seguidores"></svg>
              <div class="horas" id="ig-horas"></div>
              <div class="foot"><span id="ig-sync">SIN CONECTAR</span><span>CADA HORA · SOLO LECTURA</span></div>
            </div>
            <div class="cell c-8" id="ig-posts-cell">
              <div class="cell-h"><h3>Publicaciones</h3><span class="jp">投稿</span></div>
              <div class="posts" id="ig-posts"></div>
              <div class="foot"><span>ESTADÍSTICAS DE LAS 24 MÁS RECIENTES · META LAS DA CON HASTA 48 H DE RETRASO</span><span id="ig-posts-n"></span></div>
            </div>
            <div class="cell c-12" id="tk-cell">
              <div class="cell-h"><h3>Claude · tokens por modelo</h3><span class="jp">トークン</span></div>
              <div class="kpis">
                <div class="kpi"><div class="k">Hoy</div><div class="v" data-t="hoy">—</div><div class="d" data-t="hoy_d"></div></div>
                <div class="kpi"><div class="k">7 días</div><div class="v" data-t="d7">—</div><div class="d" data-t="d7_d"></div></div>
                <div class="kpi"><div class="k">30 días</div><div class="v" data-t="d30">—</div><div class="d" data-t="d30_d"></div></div>
                <div class="kpi"><div class="k">LIFE · 30 días</div><div class="v" data-t="life">—</div><div class="d" data-t="life_d"></div></div>
              </div>
              <svg class="heat-svg" id="tk-chart" viewBox="0 0 560 150" role="img" aria-label="Tokens de Claude por día y modelo en los últimos 30 días"></svg>
              <div class="legend" id="tk-legend"></div>
              <div class="tk-tablas"><div class="rows" id="tk-modelos"></div><div class="rows" id="tk-proyectos"></div></div>
              <div class="foot"><span id="tk-foot">SIN LEER</span><span>CLAUDE CODE Y LIFE · LOS CHATS DE CLAUDE.AI Y LOS LÍMITES DEL PLAN NO SE PUEDEN LEER</span></div>
            </div>
            <div class="cell c-4" data-youtube>
              <div class="cell-h"><h3 id="yt-h">YouTube</h3><span class="jp">動画</span></div>
              <div class="kpis two">
                <div class="kpi"><div class="k">Suscriptores</div><div class="v" data-y="subs">—</div><div class="d" data-y="subs_d"></div></div>
                <div class="kpi"><div class="k">Vistas · 28 d</div><div class="v" data-y="views">—</div><div class="d" data-y="views_d"></div></div>
                <div class="kpi"><div class="k">Horas vistas · 28 d</div><div class="v" data-y="horas">—</div><div class="d" data-y="horas_d"></div></div>
                <div class="kpi"><div class="k">Retención media</div><div class="v" data-y="ret">—</div><div class="d" data-y="ret_d"></div></div>
              </div>
              <svg class="heat-svg" id="yt-chart" viewBox="0 0 300 70" role="img" aria-label="Vistas diarias de YouTube en los últimos 28 días"></svg>
              <div class="rows" id="yt-videos"></div>
              <div class="rows yt-traf" id="yt-trafico"></div>
              <div class="foot"><span id="yt-sync">SIN CONECTAR</span><span>CADA HORA</span></div>
            </div>
          </div>
        </section>

        <!-- CONEXIONES -->
        <section class="view" id="v-conexiones" role="tabpanel" aria-labelledby="tab-conexiones" hidden>
          <div class="grid">
            <div class="cell c-8">
              <div class="cell-h"><h3>Conexiones</h3><span class="jp">接続設定</span></div>
              <div class="conn">
                <div><h4>GitHub</h4><div class="state" id="gh-state">Sin conectar</div></div>
                <div>
                  <p id="gh-help">Crea un token de acceso detallado de solo lectura en
                    <span class="copy">github.com/settings/personal-access-tokens/new</span>
                    (permisos de repositorio: Metadata y Contents en lectura) y pégalo aquí. Se guarda en el Administrador de credenciales de Windows.</p>
                  <form class="field" id="gh-form" autocomplete="off">
                    <input id="gh-token" type="password" placeholder="github_pat_…" aria-label="Token de GitHub" spellcheck="false" />
                    <button class="btn solid" type="submit" id="gh-connect">Conectar</button>
                  </form>
                  <div class="msg" id="gh-msg" role="status"></div>
                </div>
                <div class="actions">
                  <button class="btn" type="button" id="gh-sync" hidden>Sincronizar</button>
                  <button class="btn danger" type="button" id="gh-off" hidden>Desconectar</button>
                </div>
              </div>
              <div class="conn">
                <div><h4>Gmail</h4><div class="state" id="gm-state">Sin conectar</div></div>
                <div>
                  <p id="gm-help">Lee solo los correos de <span class="copy">web@glutamatocult.com</span>. Activa la verificación en dos pasos de Google, crea una contraseña de aplicación en
                    <span class="copy">myaccount.google.com/apppasswords</span> (nombre: LIFE) y pégala aquí con tu dirección.
                    Se guarda en el Administrador de credenciales de Windows. LIFE abre el buzón en modo examinar: nunca marca, mueve, borra ni envía nada.</p>
                  <form class="field" id="gm-form" autocomplete="off">
                    <input id="gm-user" type="email" placeholder="tu@gmail.com" aria-label="Dirección de Gmail" spellcheck="false" />
                    <input id="gm-pass" type="password" placeholder="contraseña de aplicación · 16 letras" aria-label="Contraseña de aplicación de Google" spellcheck="false" />
                    <button class="btn solid" type="submit" id="gm-connect">Conectar</button>
                  </form>
                  <div class="msg" id="gm-msg" role="status"></div>
                </div>
                <div class="actions">
                  <button class="btn" type="button" id="gm-sync" hidden>Sincronizar</button>
                  <button class="btn danger" type="button" id="gm-off" hidden>Desconectar</button>
                </div>
              </div>
              <div class="conn">
                <div><h4>Claude</h4><div class="state" id="cl-state">Comprobando…</div></div>
                <div>
                  <p id="cl-help">El parte del día, el semanal y las preguntas los escribe Claude con <b>tu suscripción</b>, a través de Claude Code (instalado en <span class="copy">%USERPROFILE%\.local\bin</span>). Para iniciar sesión una vez, en PowerShell: <span class="copy">&amp; "$env:USERPROFILE\.local\bin\claude.exe" auth login</span>. A Claude solo le llegan los datos de cada tarea (sin nombres ni correos de clientes, sin tokens).</p>
                  <div class="field">
                    <label class="switch" for="cl-activo"><input type="checkbox" id="cl-activo" /> Parte con Claude cada mañana a las 7:30</label>
                    <select id="cl-modelo" aria-label="Modelo de Claude"><option value="sonnet">Sonnet</option><option value="haiku">Haiku (más rápido)</option><option value="opus">Opus</option></select>
                    <button class="btn" type="button" id="cl-probar">Escribir el parte ahora</button>
                  </div>
                  <div class="msg" id="cl-msg" role="status"></div>
                </div>
                <div></div>
              </div>
              <div class="conn">
                <div><h4>Revolut</h4><div class="state" id="rv-state">Sin conectar</div></div>
                <div>
                  <h5 class="conn-sub">Conexión directa · Open Banking <span class="muted" id="rv-bank-state"></span></h5>
                  <div id="rv-bank-help">
                    <p>Revolut no da acceso a cuentas personales: se entra por Open Banking (PSD2) con <span class="copy">Enable Banking</span>, gratis para tus propias cuentas. Solo permiso de lectura. Una vez:</p>
                    <ol class="steps">
                      <li>Crea una cuenta en <span class="copy">enablebanking.com/cp</span>.</li>
                      <li>Registra una aplicación en <b>Production</b>: nombre <span class="copy">LIFE</span>, redirect URL exactamente <span class="copy">https://localhost/life</span>, tu correo, y en privacidad y condiciones vale <span class="copy">https://github.com/ohmanu/life</span>. Deja que genere la clave en el navegador: se descarga un <b>.pem</b>.</li>
                      <li>En la aplicación pulsa <b>Activate by linking accounts</b> y vincula tu Revolut.</li>
                      <li>Pega aquí el ID de la aplicación y elige el .pem. Queda en las credenciales de Windows: después borra el archivo.</li>
                    </ol>
                  </div>
                  <form class="field" id="rv-bank-form" autocomplete="off">
                    <input id="rv-app-id" type="text" placeholder="ID de la aplicación · aaaaaaaa-bbbb-…" aria-label="ID de la aplicación de Enable Banking" spellcheck="false" />
                    <button class="btn solid" type="submit" id="rv-app-save">Elegir .pem y guardar</button>
                  </form>
                  <div class="field" id="rv-bank-actions" hidden>
                    <button class="btn solid" type="button" id="rv-bank-connect">Conectar con Revolut</button>
                    <button class="btn" type="button" id="rv-bank-sync" hidden>Sincronizar</button>
                    <button class="btn danger" type="button" id="rv-bank-off">Desconectar</button>
                  </div>
                  <div class="msg" id="rv-bank-msg" role="status"></div>
                </div>
                <div></div>
              </div>
              <div class="conn">
                <div><h4>Instagram</h4><div class="state" id="ig-state">Sin conectar</div></div>
                <div>
                  <div id="ig-help">
                    <p>API oficial de Instagram, solo lectura (perfil, publicaciones y estadísticas). La cuenta tiene que ser de creador o empresa; no hace falta página de Facebook. Una vez:</p>
                    <ol class="steps">
                      <li>En <span class="copy">developers.facebook.com/apps</span> crea una app con el caso de uso <b>Gestionar mensajes y contenido en Instagram</b> y asígnale un <b>porfolio empresarial</b> (gratis; se crea en <span class="copy">business.facebook.com</span>).</li>
                      <li>En el caso de uso, <b>API setup with Unified login</b> → <b>Crear configuración</b>: deja solo <span class="copy">instagram_basic</span> e <span class="copy">instagram_manage_insights</span>, la caducidad más larga que ofrezca y como dirección de redirección <span class="copy">https://localhost/life</span>.</li>
                      <li>En <b>Generar identificadores de acceso</b> → <b>Añadir cuenta</b> con tu Instagram y acepta la invitación de tester en Instagram (Configuración → Apps y sitios web).</li>
                      <li>Pulsa <b>Generar identificador</b>, copia el token y pégalo aquí.</li>
                    </ol>
                  </div>
                  <form class="field" id="ig-form" autocomplete="off">
                    <input id="ig-token" type="password" placeholder="Token de acceso de Meta" aria-label="Token de Instagram" spellcheck="false" />
                    <button class="btn solid" type="submit" id="ig-connect">Conectar</button>
                  </form>
                  <div class="msg" id="ig-msg" role="status"></div>
                </div>
                <div class="actions">
                  <button class="btn" type="button" id="ig-sync-btn" hidden>Sincronizar</button>
                  <button class="btn danger" type="button" id="ig-off" hidden>Desconectar</button>
                </div>
              </div>
              <div class="conn" data-youtube>
                <div><h4>YouTube</h4><div class="state" id="yt-state">Sin conectar</div></div>
                <div>
                  <div id="yt-help">
                    <p>APIs oficiales de Google, solo lectura (canal, vídeos y estadísticas). Una vez, en <span class="copy">console.cloud.google.com</span>:</p>
                    <ol class="steps">
                      <li>Crea un proyecto <span class="copy">LIFE</span> y en <b>APIs y servicios → Biblioteca</b> habilita <b>YouTube Data API v3</b> y <b>YouTube Analytics API</b>.</li>
                      <li>En <b>Google Auth Platform</b> (pantalla de consentimiento): público <b>Externo</b>, nombre <span class="copy">LIFE</span> y tu correo. En <b>Público</b>, pulsa <b>Publicar app</b> para que el permiso no caduque a los 7 días (Google avisará de que no está verificada: es tuya).</li>
                      <li>En <b>Clientes</b> → <b>Crear cliente</b> → tipo <b>App de escritorio</b>. Copia el ID y el secreto y pégalos aquí.</li>
                    </ol>
                  </div>
                  <form class="field" id="yt-form" autocomplete="off">
                    <input id="yt-id" type="text" placeholder="ID de cliente · ….apps.googleusercontent.com" aria-label="ID de cliente de Google" spellcheck="false" />
                    <input id="yt-secret" type="password" placeholder="Secreto de cliente" aria-label="Secreto de cliente de Google" spellcheck="false" />
                    <button class="btn solid" type="submit" id="yt-save">Guardar</button>
                  </form>
                  <div class="field" id="yt-actions" hidden>
                    <button class="btn solid" type="button" id="yt-connect">Conectar con YouTube</button>
                    <button class="btn" type="button" id="yt-sync-btn" hidden>Sincronizar</button>
                    <button class="btn danger" type="button" id="yt-off">Desconectar</button>
                  </div>
                  <div class="msg" id="yt-msg" role="status"></div>
                </div>
                <div></div>
              </div>
            </div>
            <div class="cell c-4">
              <div class="cell-h"><h3>Sistema</h3><span class="jp">システム</span></div>
              <div class="rows">
                <label class="row switch" for="autostart"><span>Abrir LIFE al iniciar Windows</span><input type="checkbox" id="autostart" /></label>
                <label class="row switch" for="sonidos"><span>Sonidos</span><input type="checkbox" id="sonidos" /></label>
                <div class="row"><span>Al cerrar la ventana</span><span>se queda en la bandeja</span></div>
                <div class="row"><span>Datos</span><span>life.db cifrada en tu equipo</span></div>
                <div class="row"><span>Avisos</span><span>encargos nuevos · 48 h · banco</span></div>
                <div class="row"><span>Lectura</span><span>Gmail 10 min · redes 1 h · banco 6 h</span></div>
                <div class="row"><span>Claves</span><span>Credenciales de Windows</span></div>
                <div class="row"><span>Abrir o esconder LIFE</span><span>Ctrl+Alt+L, desde cualquier sitio</span></div>
                <div class="row"><span>Ocultar cifras</span><span>tecla P</span></div>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
